#!/usr/bin/env bash
set -Eeuo pipefail

REPO="https://github.com/Spruhantom/tomos.git"
APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tomphone"
BIN_DIR="${HOME}/.local/bin"
DESKTOP_DIR="${HOME}/.local/share/applications"

if [[ "$(uname -m)" != "x86_64" ]]; then
  echo "Tomphone desktop build currently targets x86_64 Linux." >&2
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  echo "git is required. Install it with: sudo pacman -S --needed git" >&2
  exit 1
fi

# If GitHub CLI is already authenticated, configure Git to use its credentials
# so private repositories can be cloned without embedding a token in this script.
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  gh auth setup-git
fi

sudo pacman -S --needed --noconfirm base-devel git qt6-base qt6-declarative baresip libpulse

mkdir -p "$(dirname "$APP_DIR")" "$BIN_DIR" "$DESKTOP_DIR"
if [[ -d "$APP_DIR/.git" ]]; then
  git -C "$APP_DIR" pull --ff-only
else
  git clone "$REPO" "$APP_DIR"
fi

cd "$APP_DIR"
chmod +x bin/build
./bin/build

install -Dm755 "$APP_DIR/build/tomphone" "$BIN_DIR/tomphone"
install -Dm644 "$APP_DIR/pkgbuild/tomphone.desktop" "$DESKTOP_DIR/tomphone.desktop"
install -Dm644 "$APP_DIR/pkgbuild/tomphone.svg" "${HOME}/.local/share/icons/hicolor/scalable/apps/tomphone.svg"

if ! printf '%s' "$PATH" | tr ':' '\n' | grep -Fxq "$BIN_DIR"; then
  echo "Add $BIN_DIR to PATH to launch with: tomphone"
fi
echo "Tomphone build complete. Launch with: $BIN_DIR/tomphone"
